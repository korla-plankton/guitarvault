<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for GuitarVault.

    Collection data (guitars, serial numbers, valuations, insurance info, photos)
    is PRIVATE user data and must never be silently synced to Google's cloud
    backup. Users move/backup their collection explicitly via Export/Import
    (ZIP), which is the intended and only backup mechanism.
-->
<full-backup-content>
    <!-- Exclude everything in the app's private storage -->
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
